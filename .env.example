# ============================================================================
# Segawa TradeAI — environment template
# Copy to `.env` (repo root) or `frontend/.env` and fill in.
#
# ⚠️  ONLY VITE_* variables reach the browser. They are PUBLIC by design.
#     Never put an OpenAI key, service-role key, password or keystore here.
# ============================================================================

# --- Frontend (public) ---------------------------------------------------
# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=
# Supabase ANON (public) key — safe to ship, protected by Row Level Security
VITE_SUPABASE_ANON_KEY=

# Edge function name for AI requests (default: ai-coach)
VITE_AI_FUNCTION=ai-coach

# Base path. Leave empty for local dev / APK.
# For GitHub Pages use /Segawa-Trading-AI/
VITE_BASE_PATH=

# --- Server-side secrets (Supabase Edge Functions ONLY) ------------------
# Set these with:  supabase secrets set KEY=value
# They must never appear in this file's committed values or in frontend code.
#
# OPENAI_API_KEY=sk-...
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Android release signing (CI secrets ONLY, never committed) ----------
# ANDROID_KEYSTORE_BASE64=<base64 of your .keystore>
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
